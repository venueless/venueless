// Logos for Xing/Discord/Telegram/VK
.mdi.mdi-xing::before, .mdi.mdi-discord::before, .mdi.mdi-telegram::before, .mdi.mdi-vk::before
	content: "\F0339"
	-webkit-text-fill-color: transparent
	background-color: currentColor
	-webkit-mask-position: center
	mask-position: center
	-webkit-mask-size: calc(1em * 20 / 24)
	mask-size: calc(1em * 20 / 24)
	-webkit-mask-repeat: no-repeat
	mask-repeat: no-repeat

.mdi.mdi-xing::before
	-webkit-mask-image: url('../assets/brand-icons/xing.svg')
	mask-image: url('../assets/brand-icons/xing.svg')
.mdi.mdi-discord::before
	-webkit-mask-image: url('../assets/brand-icons/discord.svg')
	mask-image: url('../assets/brand-icons/discord.svg')
.mdi.mdi-telegram::before
	-webkit-mask-image: url('../assets/brand-icons/telegram.svg')
	mask-image: url('../assets/brand-icons/telegram.svg')
.mdi.mdi-vk::before
	-webkit-mask-image: url('../assets/brand-icons/vk.svg')
	mask-image: url('../assets/brand-icons/vk.svg')
